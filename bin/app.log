                                <div style="flex: 1;">
                                    <div style="font-weight: bold; font-size: 15px; color: #333;">${contact.name}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 3px;">
                                        ID: ${contact.id}
                                    </div>
                                </div>
                                <div style="color: #07c160; font-size: 12px; font-weight: bold; margin-right: 5px;">
                                    好友
                                </div>
                            </div>
                        `;
                    });
                }
                
                // 添加AI机器人分组
                if (aiRobots.length > 0) {
                    contactsHtml += `
                        <div class="contact-group-title">AI机器人 (${aiRobots.length})</div>
                    `;
                    
                    aiRobots.forEach((contact, index) => {
                        // 获取联系人名字的第一个字符作为头像
                        const avatarText = contact.name && contact.name.length > 0 ? contact.name.charAt(0) : '?';
                        
                        contactsHtml += `
                            <div class="contact-item" style="display: flex; align-items: center; padding: 12px 15px; border-bottom: 1px solid #e0e0e0; cursor: pointer; transition: background-color 0.2s;" 
                                 onclick="selectContact('${contact.id}', '${contact.name}', true)"
                                 onmouseover="this.style.backgroundColor='#f9f9f9'"
                                 onmouseout="this.style.backgroundColor='white'">
                                <div class="avatar-container">
                                    <div class="avatar ai-avatar">
                                        ${avatarText}
                                    </div>
                                    <!-- 红点将动态添加到这里 -->
                                </div>
                                <div style="flex: 1;">
                                    <div style="font-weight: bold; font-size: 15px; color: #333;">${contact.name}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 3px;">
                                        ID: ${contact.id}
                                        <span style="color: #9c27b0; margin-left: 5px;">[AI]</span>
                                    </div>
                                </div>
                                <div style="color: #9c27b0; font-size: 12px; font-weight: bold; margin-right: 5px;">
                                    AI
                                </div>
                            </div>
                        `;
                    });
                }
                
                // 更新联系人列表容器
                contactListContainer.innerHTML = `
                    <div style="overflow-y: auto; height: 100%;">
                        ${contactsHtml}
