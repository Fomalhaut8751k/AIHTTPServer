        .search-input:focus {
            background-color: white;
            box-shadow: 0 0 0 1px #07c160;
        }

        /* 联系人列表 */
        .contact-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
        }

        .empty-contacts {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
