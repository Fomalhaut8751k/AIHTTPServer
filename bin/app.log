            padding: 10px 15px;
            border-radius: 18px 18px 4px 18px;
            font-size: 14px;
            word-break: break-word;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }
        
        .message-bubble-other {
            max-width: 70%;
            background-color: white;
