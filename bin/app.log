        /* 消息样式 */
        .message-self {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 15px;
            padding: 0 20px;
        }
        
        .message-other {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 15px;
            padding: 0 20px;
        }
        
        .message-bubble-self {
            max-width: 70%;
