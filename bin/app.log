                { id: 2, name: '李四', avatar: '李', lastMessage: '在吗？', unread: 1, online: false },
                { id: 3, name: '王五', avatar: '王', lastMessage: '晚上一起吃饭', unread: 0, online: true }
            ];
            
            // DOM元素
            const contactList = document.getElementById('contact-list');
            const emptyContacts = document.getElementById('empty-contacts');
            const chatArea = document.getElementById('chat-area');
            const inputArea = document.getElementById('input-area');
            const messageInput = document.getElementById('message-input');
            const sendBtn = document.getElementById('send-btn');
            const searchInput = document.getElementById('search-input');
            const addFriendBtn = document.getElementById('add-friend-btn');
            const currentChatName = document.getElementById('current-chat-name');
            const currentChatStatus = document.getElementById('current-chat-status');
            const messagesContainer = document.getElementById('messages-container');
            
            // 当前选中的聊天
            let currentChatId = null;
            
            // 渲染好友列表
            function renderFriendList() {
                if (friends.length === 0) {
                    emptyContacts.style.display = 'flex';
                    return;
                }
                
                emptyContacts.style.display = 'none';
                contactList.innerHTML = '';
                
                friends.forEach(friend => {
                    const contactItem = document.createElement('div');
                    contactItem.className = `contact-item ${friend.id === currentChatId ? 'active' : ''}`;
                    contactItem.dataset.id = friend.id;
                    
                    contactItem.innerHTML = `
                        <div class="contact-avatar">${friend.avatar}</div>
                        <div class="contact-info">
                            <div class="contact-name">${friend.name}</div>
                            <div class="last-message">${friend.lastMessage}</div>
                        </div>
                        ${friend.unread > 0 ? `<div class="unread-badge">${friend.unread}</div>` : ''}
                    `;
                    
                    contactItem.addEventListener('click', () => selectChat(friend));
                    contactList.appendChild(contactItem);
                });
            }
            
            // 选择聊天
            function selectChat(friend) {
                currentChatId = friend.id;
                
                // 更新UI
                document.querySelectorAll('.contact-item').forEach(item => {
                    item.classList.remove('active');
                    if (parseInt(item.dataset.id) === friend.id) {
                        item.classList.add('active');
                    }
                });
                
                // 更新聊天头部
                currentChatName.textContent = friend.name;
                currentChatStatus.textContent = friend.online ? '在线' : '离线';
                currentChatStatus.style.color = friend.online ? '#07c160' : '#888';
                
                // 显示聊天区域
                chatArea.classList.add('active');
                inputArea.classList.add('active');
                
                // 清空输入框
                messageInput.value = '';
                messageInput.style.height = 'auto';
                messageInput.focus();
                
                // 加载聊天记录（这里清空显示空白）
                messagesContainer.innerHTML = `
                    <div class="empty-chat">
                        <i class="fas fa-comments chat-icon"></i>
                        <h2>与 ${friend.name} 的聊天</h2>
                        <p>开始对话吧！</p>
                    </div>
                `;
            }
            
            // 发送消息
            function sendMessage() {
                const message = messageInput.value.trim();
                if (!message || !currentChatId) return;
                
                // 找到当前聊天的好友
                const friend = friends.find(f => f.id === currentChatId);
                if (!friend) return;
                
                // 更新好友的最后一条消息
                friend.lastMessage = message;
                friend.unread = 0; // 重置未读消息数（因为是用户自己发的）
                
                // 重新渲染好友列表
                renderFriendList();
                
                // 清空输入框
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 这里可以添加发送消息到服务器的逻辑
                console.log(`发送消息给 ${friend.name}: ${message}`);
                
                // 模拟对方回复（2秒后）
                setTimeout(() => {
                    const replies = [
                        '好的',
                        '收到',
                        '明白了',
                        '👌',
                        '一会儿聊'
                    ];
                    const reply = replies[Math.floor(Math.random() * replies.length)];
                    friend.lastMessage = reply;
                    friend.unread = (friend.unread || 0) + 1;
                    renderFriendList();
                }, 2000);
            }
            
            // 添加好友
            function addFriend() {
                const newFriendName = prompt('请输入好友用户名：');
                if (!newFriendName || newFriendName.trim() === '') return;
                
                // 模拟添加到好友列表
                const newFriend = {
                    id: friends.length + 1,
                    name: newFriendName.trim(),
                    avatar: newFriendName.trim().charAt(0),
                    lastMessage: '你们已经成为好友，开始聊天吧！',
                    unread: 1,
                    online: true
                };
                
                friends.push(newFriend);
                renderFriendList();
                
                alert(`成功添加好友：${newFriendName}`);
            }
            
            // 搜索好友
            function searchFriends(keyword) {
                if (!keyword.trim()) {
                    renderFriendList();
                    return;
                }
                
                const filteredFriends = friends.filter(friend => 
                    friend.name.toLowerCase().includes(keyword.toLowerCase())
                );
                
                if (filteredFriends.length === 0) {
                    emptyContacts.style.display = 'flex';
                    emptyContacts.innerHTML = `
                        <i class="fas fa-search chat-icon"></i>
                        <h3>未找到好友</h3>
                        <p>没有找到匹配"${keyword}"的好友</p>
                    `;
                    contactList.innerHTML = '';
                } else {
                    // 渲染筛选后的好友列表
                    emptyContacts.style.display = 'none';
                    contactList.innerHTML = '';
                    
                    filteredFriends.forEach(friend => {
                        const contactItem = document.createElement('div');
                        contactItem.className = `contact-item ${friend.id === currentChatId ? 'active' : ''}`;
                        contactItem.dataset.id = friend.id;
                        
                        contactItem.innerHTML = `
                            <div class="contact-avatar">${friend.avatar}</div>
                            <div class="contact-info">
                                <div class="contact-name">${friend.name}</div>
                                <div class="last-message">${friend.lastMessage}</div>
                            </div>
                        `;
                        
                        contactItem.addEventListener('click', () => selectChat(friend));
                        contactList.appendChild(contactItem);
                    });
                }
            }
            
            // 事件监听
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
            
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });
            
            sendBtn.addEventListener('click', sendMessage);
            addFriendBtn.addEventListener('click', addFriend);
            
            searchInput.addEventListener('input', function() {
                searchFriends(this.value);
            });
            
            // 标签页切换
            document.querySelectorAll('.tab-item').forEach(tab => {
                tab.addEventListener('click', function() {
                    document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    const tabLabel = this.querySelector('.tab-label').textContent;
                    alert(`切换到 ${tabLabel} 页面（模拟功能）`);
                });
            });
            
            // 初始渲染好友列表
            renderFriendList();
            
            // 模拟：如果用户名为空，提示登录
            if (getCurrentUser() === '用户') {
                setTimeout(() => {
                    const username = prompt('请先输入您的用户名：');
                    if (username && username.trim()) {
                        sessionStorage.setItem('username', username.trim());
                        updateUsernameDisplay();
                        alert(`欢迎回来，${username.trim()}！`);
                    }
                }, 500);
            }
        });
    </script>
</body>

