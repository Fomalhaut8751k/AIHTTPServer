            flex-direction: column;
            background-color: #f0f0f0;
        }

        /* 聊天头部 */
        .chat-header {
            height: 50px;
            background-color: white;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            padding: 0 15px;
            font-weight: bold;
            color: #666;
        }

        /* 空白聊天界面 */
        .empty-chat {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #999;
            padding: 20px;
            text-align: center;
        }

        .chat-icon {
            font-size: 50px;
            margin-bottom: 20px;
            color: #07c160;
        }

        /* 输入区域 */
        .input-area {
            background-color: white;
            padding: 10px 15px;
            border-top: 1px solid #e0e0e0;
            display: flex;
