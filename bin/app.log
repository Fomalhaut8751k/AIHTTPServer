            display: flex;
            align-items: flex-start;
            position: relative;
        }

        .control-panel {
            position: absolute;
            left: 100%;
            margin-left: 30px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            top: 20px;
        }

        .control-btn {
            padding: 10px 20px;
            font-size: 16px;
