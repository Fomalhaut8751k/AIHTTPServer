<script>const userId = '1';</script></head>

<body>
    <!-- 顶部导航栏 -->
    <div class="navbar">
        <div style="display: flex; align-items: center;">
            <i class="fas fa-comment-alt" style="margin-right: 10px;"></i>
            <div class="app-name">Hello, wudongwei</div>
        </div>
        <div class="dropdown">
            <i class="fas fa-plus nav-icon" title="添加" id="add-button"></i>
            <div class="dropdown-content" id="dropdown-menu">
                <a id="add-user">
                    <i class="fas fa-user-plus"></i>添加用户
                </a>
                <a id="add-ai">
                    <i class="fas fa-robot"></i>添加AI机器人
                </a>
            </div>
        </div>
    </div>

    <!-- 主容器 -->
    <div class="main-container">
        <!-- 左侧边栏 -->
        <div class="sidebar">
            <div class="search-box">
                <input type="text" class="search-input" placeholder="搜索">
            </div>
            
            <div class="contact-list">
                <div class="empty-contacts">
                    <i class="fas fa-user-friends empty-icon"></i>
                    <h3>暂无联系人</h3>
                    <p>点击右上角"+"添加好友或AI机器人</p>
                </div>
            </div>
        </div>

        <!-- 聊天区域 -->
        <div class="chat-area">
            <!-- 聊天头部 -->
            <div class="chat-header">
                选择一个聊天开始对话
            </div>
            
            <!-- 聊天消息容器 -->
            <div class="chat-messages-container">
                <!-- 空白聊天界面 -->
                <div class="empty-chat" id="empty-chat">
                    <i class="fas fa-comments chat-icon"></i>
                    <h2>开始聊天</h2>
                    <p>从左侧选择或添加好友/AI机器人开始聊天</p>
                </div>
                
                <!-- 聊天消息区域（动态生成） -->
                <div class="chat-messages" id="chat-messages" style="display: none;"></div>
            </div>
            
            <!-- 输入区域 -->
            <div class="input-area">
                <textarea class="message-input" id="message-input" placeholder="选择一个联系人开始聊天..." rows="1" disabled></textarea>
                <button class="send-btn" id="send-btn" disabled>发送</button>
            </div>
        </div>
    </div>
    
    <!-- 底部标签栏 -->
    <div class="tab-bar">
        <div class="tab-item active">
            <i class="fas fa-comment-alt tab-icon"></i>
            <div class="tab-label">微信</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-address-book tab-icon"></i>
            <div class="tab-label">通讯录</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-compass tab-icon"></i>
            <div class="tab-label">发现</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-user tab-icon"></i>
            <div class="tab-label">我</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let messageInput = document.getElementById('message-input');
            let sendBtn = document.getElementById('send-btn');
            const emptyChat = document.getElementById('empty-chat');
            const chatMessages = document.getElementById('chat-messages');
            const addUserBtn = document.getElementById('add-user');
            const addAiBtn = document.getElementById('add-ai');
            const dropdownMenu = document.getElementById('dropdown-menu');
            
            // ========== 全局数据存储 ==========
            let offlineMessages = {};      // 离线消息（未读）
            let chatHistory = {};          // 聊天历史记录（仅存储已加载的联系人）
            let currentContact = null;     // 当前选中的联系人
            let currentUserId = null;      // 当前用户ID（需要从服务器获取）
            let searchMode = '';           // 搜索模式：'user' 或 'ai'
            let allContacts = [];          // 存储所有联系人（好友+AI）
            let isWaitingForAIResponse = false; // 是否正在等待AI回复
            
            // ========== 添加下拉菜单控制 ==========
            const addButton = document.getElementById('add-button');
            
            // 点击 + 按钮显示下拉菜单
            addButton.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });
            
            // 点击其他地方关闭下拉菜单
            document.addEventListener('click', function() {
                dropdownMenu.classList.remove('show');
            });
            
            // 阻止下拉菜单内的点击事件冒泡
            dropdownMenu.addEventListener('click', function(e) {
                e.stopPropagation();
            });
            
            // ========== 添加用户功能 ==========
            addUserBtn.addEventListener('click', function() {
                console.log('添加用户被点击');
                searchMode = 'user';
                dropdownMenu.classList.remove('show');
                switchToSearchMode('user');
                
                // 发送POST请求获取搜索数据
                fetch('/user/search', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'get_search_ui',
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    return response.json();
                })
                .then(data => {
                    console.log('收到搜索数据:', data);
                    
                    // 如果有数据，可以更新UI
                    if (data && data.suggestedUsers) {
                        // 可以在这里显示推荐用户
                        updateSuggestedUsers(data.suggestedUsers);
                    }
                })
                .catch(error => {
                    console.error('请求失败:', error);
                    alert('搜索功能暂时不可用');
                });
            });
            
            // ========== 添加AI机器人功能 ==========
            addAiBtn.addEventListener('click', function() {
                console.log('添加AI机器人被点击');
                searchMode = 'ai';
                dropdownMenu.classList.remove('show');
                switchToSearchMode('ai');
                
                // 发送POST请求获取AI机器人搜索数据
                fetch('/user/aisearch', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'search_robot',
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    return response.json();
                })
                .then(data => {
                    console.log('收到AI搜索数据:', data);
                    
                    // 如果有数据，可以更新UI
                    if (data && data.suggestedAIs) {
                        // 可以在这里显示推荐AI机器人
                        updateSuggestedAIs(data.suggestedAIs);
                    }
                })
                .catch(error => {
                    console.error('请求失败:', error);
                    alert('AI搜索功能暂时不可用');
                });
            });
            
            // ========== 页面加载时自动获取联系人列表 ==========
            function loadAllContacts() {
                // 清空所有联系人
                allContacts = [];
                
                // 先加载好友列表
                fetch('/user/friendlist', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'get_contact_list'
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(friendData => {
                    console.log('收到好友数据:', friendData);
                    
                    // 处理好友数据
                    if (friendData && friendData.contacts && friendData.contacts.length > 0) {
                        // 标记好友类型
                        friendData.contacts.forEach(contact => {
                            contact.type = 'user'; // 好友类型
                            allContacts.push(contact);
                        });
                        
                        // 获取当前用户ID
                        if (friendData.currentUserId) {
                            currentUserId = friendData.currentUserId;
                            console.log('当前用户ID:', currentUserId);
                        }
                    }
                    
                    // 然后加载AI机器人列表
                    return fetch('/user/airobotlist', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json' 
                        },
                        body: JSON.stringify({
                            action: 'get_ai_robot_list'
                        })
                    });
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(aiData => {
                    console.log('收到AI机器人数据:', aiData);
                    
                    // 处理AI机器人数据
                    if (aiData && aiData.contacts && aiData.contacts.length > 0) {
                        // 标记AI类型
                        aiData.contacts.forEach(contact => {
                            contact.type = 'ai'; // AI机器人类型
                            allContacts.push(contact);
                        });
                    }
                    
                    // 更新联系人列表
                    if (allContacts.length > 0) {
                        updateContactList(allContacts);
                        
                        // 注意：这里不再初始化所有联系人的聊天历史记录
                        // 只有在用户点击联系人时才会创建对应的聊天历史记录
                        
                        // 获取离线消息（用于显示红点）
                        // fetchOfflineMessages();
                        
                    } else {
                        console.log('没有联系人数据');
                    }
                })
                .catch(error => {
                    console.error('获取联系人失败:', error);
                });
            }
            
            // 页面加载时调用
            loadAllContacts();
            
            // ========== 将离线消息合并到聊天历史（当用户点击联系人时调用）==========
            function mergeOfflineToHistory(userId) {
                if (offlineMessages[userId] && offlineMessages[userId].length > 0) {
                    // 将离线消息添加到聊天历史
                    offlineMessages[userId].forEach(msg => {
                        addMessageToHistory(userId, msg);
                    });
                    
                    // 清除离线消息
                    delete offlineMessages[userId];
                    
                    // 更新UI上的红点
                    const contactItems = document.querySelectorAll('.contact-item');
                    contactItems.forEach(item => {
                        const onclickAttr = item.getAttribute('onclick');
                        if (onclickAttr) {
                            const match = onclickAttr.match(/selectContact\('([^']+)', '([^']+)', ([^)]+)\)/);
                            if (match && match[1] === userId) {
                                const badge = item.querySelector('.unread-badge');
                                if (badge) {
                                    badge.remove();
                                }
                            }
                        }
                    });
                    
                    return true; // 有离线消息被合并
                }
                return false; // 没有离线消息
            }
            
            // ========== 添加消息到聊天历史（仅当用户点击联系人或发送消息时调用）==========
            function addMessageToHistory(userId, messageData) {
                if (!chatHistory[userId]) {
                    chatHistory[userId] = [];
                }
                
                // 添加到历史记录
                chatHistory[userId].push(messageData);
                
                // 按时间排序
                chatHistory[userId].sort((a, b) => {
                    return new Date(a.timestamp || 0) - new Date(b.timestamp || 0);
                });
            }
            
            // ========== 切换到搜索模式（支持用户和AI） ==========
            function switchToSearchMode(type) {
                const isAiSearch = type === 'ai';
                const title = isAiSearch ? 'AI机器人搜索' : '用户搜索';
                const placeholder = isAiSearch ? '按AI机器人名称搜索' : '按用户名进行搜索';
                const icon = isAiSearch ? 'fa-robot' : 'fa-search';
                
                // 1. 修改右上角图标：+ 换成 ←
                const navIcon = document.querySelector('.fa-plus');
                navIcon.classList.remove('fa-plus');
                navIcon.classList.add('fa-arrow-left');
                navIcon.title = '返回微信';
                
                // 移除原来的点击事件，添加返回功能
                const newNavIcon = navIcon.cloneNode(true);
                navIcon.parentNode.replaceChild(newNavIcon, navIcon);
                
                newNavIcon.addEventListener('click', function() {
                    switchBackToWeChat();
                });
                
                // 2. 修改聊天头部
                const chatHeader = document.querySelector('.chat-header');
                chatHeader.textContent = title;
                
                // 3. 修改空白聊天区域
                emptyChat.innerHTML = `
                    <i class="fas ${icon} chat-icon"></i>
                    <h2>${title}</h2>
                    <p>${isAiSearch ? '按AI机器人名称搜索并添加' : '按用户名搜索并添加好友'}</p>
                `;
                emptyChat.style.display = 'flex';
                chatMessages.style.display = 'none';
                
                // 4. 修改输入区域
                messageInput.placeholder = placeholder;
                messageInput.disabled = false;
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 5. 修改按钮
                sendBtn.textContent = '查找';
                sendBtn.disabled = true;
                
                // 重要：先移除原来的事件监听器，然后添加新的事件
                // 创建一个新的按钮元素来完全替换事件监听
                const oldSendBtn = sendBtn;
                const newSendBtn = sendBtn.cloneNode(true);
                sendBtn.parentNode.replaceChild(newSendBtn, sendBtn);
                
                // 重新获取新的按钮引用
                sendBtn = document.getElementById('send-btn');
                
                // 添加新的点击事件监听器
                sendBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('查找按钮被点击，搜索模式:', type);
                    performSearch(type);
                });
                
                // 6. 修改左侧边栏的微信图标
                const wechatIcon = document.querySelector('.fa-comment-alt');
                if (wechatIcon) {
                    wechatIcon.classList.remove('fa-comment-alt');
                    wechatIcon.classList.add(icon);
                }
                
                // 7. 添加输入监听，启用查找按钮
                messageInput.addEventListener('input', function() {
                    const searchText = this.value.trim();
                    sendBtn.disabled = searchText.length === 0;
                });
                
                // 8. 修改标题（可选）
                document.title = `微信 - ${title}`;
                
                console.log('已切换到搜索模式:', type);
            }
            
            // ========== 执行搜索（支持用户和AI） ==========
            function performSearch(type) {
                const searchText = messageInput.value.trim();
                
                if (!searchText) {
                    alert('请输入要搜索的内容');
                    return;
                }
                
                console.log(`正在搜索${type === 'ai' ? 'AI机器人' : '用户'}:`, searchText);
                
                // 禁用按钮，显示加载状态
                const originalText = sendBtn.textContent;
                sendBtn.textContent = '搜索中...';
                sendBtn.disabled = true;
                
                // 根据搜索类型发送不同的请求
                const endpoint = type === 'ai' ? '/user/aisearch/exist' : '/user/search/exist';
                
                fetch(endpoint, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: type === 'ai' ? 'search_ai' : 'search_user',
                        [type === 'ai' ? 'robotname' : 'username']: searchText,
                        timestamp: Date.now()
                    })
                })
                .then(response => {
                    if(response.status == 200){
                        return response.json();
                    }
                    else{
                        throw new Error('搜索失败，未知错误！');
                    }
                })
                .then(data => {
                    console.log('搜索结果:', data);
                    
                    // 恢复按钮状态
                    sendBtn.textContent = originalText;
                    sendBtn.disabled = false;
                    
                    // 处理搜索结果
                    if(!data){
                        throw new Error('服务器返回空数据');
                    } 
                    if (data.status == true) {
                        displaySearchResults([{
                            id: data['targetId'],
                            name: searchText,  // 使用搜索的名称
                            type: type  // 标记是用户还是AI
                        }], type);
                    } else {
                        alert('搜索失败，未找到对应的' + (type === 'ai' ? 'AI机器人' : '用户'));
                    }
                })
                .catch(error => {
                    console.error('搜索失败:', error);
                    
                    // 恢复按钮状态
                    sendBtn.textContent = originalText;
                    sendBtn.disabled = false;
                    
                    alert('搜索失败，请稍后重试');
                });
                
                return false; // 防止默认行为和事件冒泡
            }
            
            // ========== 显示搜索结果（支持用户和AI） ==========
            function displaySearchResults(results, type) {
                const isAi = type === 'ai';
                emptyChat.innerHTML = '';
                
                if (results.length === 0) {
                    emptyChat.innerHTML = `
                        <i class="fas fa-${isAi ? 'robot' : 'user-slash'} chat-icon"></i>
                        <h2>未找到${isAi ? 'AI机器人' : '用户'}</h2>
                        <p>没有找到匹配的${isAi ? 'AI机器人名称' : '用户名'}</p>
                        <button onclick="clearSearch()" style="margin-top: 20px; padding: 10px 20px; background: #07c160; color: white; border: none; border-radius: 5px; cursor: pointer;">
                            重新搜索
                        </button>
                    `;
                    emptyChat.style.display = 'flex';
                    chatMessages.style.display = 'none';
                    return;
                }
                
                // 显示结果列表
                let resultsHtml = `
                    <div style="text-align: left; width: 100%; max-width: 600px; margin: 0 auto;">
                        <h3 style="margin-bottom: 20px; color: #333;">找到 ${results.length} 个${isAi ? 'AI机器人' : '用户'}</h3>
                `;
                
                results.forEach((item, index) => {
                    const itemType = item.type || type;
                    const isAiItem = itemType === 'ai';
                    
                    resultsHtml += `
                        <div style="display: flex; align-items: center; padding: 15px; background: white; border-radius: 8px; margin-bottom: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                            <div style="position: relative; width: 50px; height: 50px; margin-right: 15px;">
                                <div style="width: 50px; height: 50px; background: ${isAiItem ? '#9c27b0' : '#07c160'}; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas ${isAiItem ? 'fa-robot' : 'fa-user'}" style="color: white; font-size: 20px;"></i>
                                </div>
                                ${isAiItem ? '<span style="position: absolute; bottom: -5px; right: -5px; background: #9c27b0; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 10px; border: 2px solid white;">AI</span>' : ''}
                            </div>
                            <div style="flex: 1;">
                                <div style="font-weight: bold; font-size: 16px; color: #333;">${item.name || '未知'}</div>
                                <div style="font-size: 14px; color: #666; margin-top: 5px;">
                                    ${isAiItem ? 'AI机器人' : '用户'} ID: ${item.id || 'N/A'}
                                </div>
                            </div>
                            <button onclick="${isAiItem ? `addAI('${item.id}', '${item.name}')` : `addFriend('${item.id}', '${item.name}')`}" 
                                    style="padding: 8px 15px; background: ${isAiItem ? '#9c27b0' : '#07c160'}; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;">
                                ${isAiItem ? '添加AI' : '添加好友'}
                            </button>
                        </div>
                    `;
                });
                
                resultsHtml += `
                        <div style="margin-top: 20px; text-align: center;">
                            <button onclick="clearSearch()" style="padding: 10px 20px; background: #999; color: white; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                                重新搜索
                            </button>
                            <button onclick="switchBackToWeChat()" style="padding: 10px 20px; background: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer;">
                                返回微信
                            </button>
                        </div>
                    </div>
                `;
                
                emptyChat.innerHTML = resultsHtml;
                emptyChat.style.display = 'block';
                chatMessages.style.display = 'none';
            }
            
            // ========== 更新联系人列表（支持AI和好友分组） ==========
            function updateContactList(contacts) {
                const contactListContainer = document.querySelector('.contact-list');
                if (!contactListContainer) return;
                
                if (contacts.length === 0) {
                    contactListContainer.innerHTML = `
                        <div class="empty-contacts">
                            <i class="fas fa-user-friends empty-icon"></i>
                            <h3>暂无联系人</h3>
                            <p>点击右上角"+"添加好友或AI机器人</p>
                        </div>
                    `;
                    return;
                }
                
                // 分组联系人：好友和AI机器人
                const friends = contacts.filter(contact => contact.type === 'user');
                const aiRobots = contacts.filter(contact => contact.type === 'ai');
                
                // 创建联系人列表HTML
                let contactsHtml = '';
                
                // 添加好友分组
                if (friends.length > 0) {
                    contactsHtml += `
                        <div class="contact-group-title">好友 (${friends.length})</div>
                    `;
                    
                    friends.forEach((contact, index) => {
                        // 获取联系人名字的第一个字符作为头像
                        const avatarText = contact.name && contact.name.length > 0 ? contact.name.charAt(0) : '?';
                        
                        contactsHtml += `
                            <div class="contact-item" style="display: flex; align-items: center; padding: 12px 15px; border-bottom: 1px solid #f0f0f0; cursor: pointer; transition: background-color 0.2s;" 
                                 onclick="selectContact('${contact.id}', '${contact.name}', false)"
                                 onmouseover="this.style.backgroundColor='#f9f9f9'"
                                 onmouseout="this.style.backgroundColor='white'">
                                <div class="avatar-container">
                                    <div class="avatar">
                                        ${avatarText}
                                    </div>
                                    <!-- 红点将动态添加到这里 -->
                                </div>
                                <div style="flex: 1;">
                                    <div style="font-weight: bold; font-size: 15px; color: #333;">${contact.name}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 3px;">
                                        ID: ${contact.id}
                                    </div>
                                </div>
                                <div style="color: #07c160; font-size: 12px; font-weight: bold; margin-right: 5px;">
                                    好友
                                </div>
                            </div>
                        `;
                    });
                }
                
                // 添加AI机器人分组
                if (aiRobots.length > 0) {
                    contactsHtml += `
                        <div class="contact-group-title">AI机器人 (${aiRobots.length})</div>
                    `;
                    
                    aiRobots.forEach((contact, index) => {
                        // 获取联系人名字的第一个字符作为头像
                        const avatarText = contact.name && contact.name.length > 0 ? contact.name.charAt(0) : '?';
                        
                        contactsHtml += `
                            <div class="contact-item" style="display: flex; align-items: center; padding: 12px 15px; border-bottom: 1px solid #e0e0e0; cursor: pointer; transition: background-color 0.2s;" 
                                 onclick="selectContact('${contact.id}', '${contact.name}', true)"
                                 onmouseover="this.style.backgroundColor='#f9f9f9'"
                                 onmouseout="this.style.backgroundColor='white'">
                                <div class="avatar-container">
                                    <div class="avatar ai-avatar">
                                        ${avatarText}
                                    </div>
                                    <!-- 红点将动态添加到这里 -->
                                </div>
                                <div style="flex: 1;">
                                    <div style="font-weight: bold; font-size: 15px; color: #333;">${contact.name}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 3px;">
                                        ID: ${contact.id}
                                        <span style="color: #9c27b0; margin-left: 5px;">[AI]</span>
                                    </div>
                                </div>
                                <div style="color: #9c27b0; font-size: 12px; font-weight: bold; margin-right: 5px;">
                                    AI
                                </div>
                            </div>
                        `;
                    });
                }
                
                // 更新联系人列表容器
                contactListContainer.innerHTML = `
                    <div style="overflow-y: auto; height: 100%;">
                        ${contactsHtml}
                    </div>
                `;
                
                // 显示未读消息红点
                // showUnreadBadges();
            }
            
            // ========== 选择联系人（增强版，支持AI） ==========
            window.selectContact = function(userId, userName, isAI = false) {
                console.log(`选择了${isAI ? 'AI机器人' : '联系人'}: ${userName} (ID: ${userId})`);
                
                // 如果在搜索模式，先切换回微信模式
                if (document.title.includes('搜索')) {
                    switchBackToWeChat();
                }
                
                // 更新当前联系人
                currentContact = { id: userId, name: userName, type: isAI ? 'ai' : 'user' };
                
                // 更新聊天头部
                const chatHeader = document.querySelector('.chat-header');
                chatHeader.textContent = userName + (isAI ? ' [AI]' : '');
                
                // 清空输入框
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 启用输入区域
                messageInput.placeholder = `发送消息给 ${userName}${isAI ? ' (AI)' : ''}...`;
                messageInput.disabled = false;
                sendBtn.disabled = false;
                
                // 将离线消息合并到聊天历史（如果有）
                const hasOfflineMessages = mergeOfflineToHistory(userId);
                
                // 加载聊天记录
                loadChatHistory(userId, isAI, userName, hasOfflineMessages);
            };
            
            // ========== 加载聊天记录（仅在点击联系人时调用）==========
            function loadChatHistory(contactId, isAI, contactName, hasNewOfflineMessages = false) {
                // 确定请求的端点
                const endpoint = isAI ? '/user/offlineaimessage' : '/user/offlinemessage';
                
                console.log(`正在加载${isAI ? 'AI' : '好友'}聊天记录，联系人ID: ${contactId}`);
                
                // 显示加载状态
                chatMessages.innerHTML = '<div style="text-align: center; padding: 20px; color: #999;">正在加载聊天记录...</div>';
                emptyChat.style.display = 'none';
                chatMessages.style.display = 'flex';
                
                // 发送请求获取聊天记录
                fetch(endpoint, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'get_chat_history',
                        targetId: contactId
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log(`收到${isAI ? 'AI' : '好友'}聊天记录:`, data);
                    
                    // 清空聊天消息区域
                    chatMessages.innerHTML = '';
                    
                    if (data && data.status === true && data.message) {
                        // 处理聊天记录数据
                        const chatData = data.message;
                        
                        // 初始化该联系人的聊天历史记录（如果还没有的话）
                        if (!chatHistory[contactId]) {
                            chatHistory[contactId] = [];
                        }
                        
                        // 清空当前联系人的历史记录（重新加载）
                        chatHistory[contactId] = [];
                        
                        // 处理聊天消息
                        let hasOfflineMessagesShown = false;
                        let lastDate = null;
                        
                        chatData.forEach((msg, index) => {
                            // 检查是否是离线消息
                            const isNewOffline = hasNewOfflineMessages && index >= chatData.length - (offlineMessages[contactId]?.length || 0);
                            
                            // 如果是新离线消息，并且还没有添加分隔线，则添加
                            if (isNewOffline && hasNewOfflineMessages && !hasOfflineMessagesShown) {
                                addOfflineDivider();
                                hasOfflineMessagesShown = true;
                            }
                            
                            // 添加时间分隔线（每天一个）
                            const msgDate = msg.timestamp ? msg.timestamp.split(' ')[0] : null;
                            if (msgDate && msgDate !== lastDate) {
                                addTimeDivider(msgDate);
                                lastDate = msgDate;
                            }
                            
                            // 根据联系人类型和source判断消息方向
                            let isFromOther = false;
                            
                            if (isAI) {
                                // AI聊天记录：source为"user"是用户消息（显示在右侧），source为"robot"是AI消息（显示在左侧）
                                isFromOther = msg.source === 'robot';
                            } else {
                                // 好友聊天记录：source为"user"是用户消息（显示在右侧），source为"friend"是好友消息（显示在左侧）
                                isFromOther = msg.source === 'friend';
                            }
                            
                            // 添加到聊天历史
                            chatHistory[contactId].push({
                                message: msg.message,
                                timestamp: msg.timestamp,
                                source: msg.source, // 'user' 或 'friend'（好友）/ 'robot'（AI）
                                senderId: isFromOther ? contactId : currentUserId,
                                isFromOther: isFromOther,
                                isAI: isAI
                            });
                            
                            // 添加到聊天界面
                            addMessageToChat(msg.message, msg.timestamp, isFromOther, false, isAI, isFromOther ? contactId : currentUserId);
                        });
                        
                        // 滚动到底部
                        scrollToBottom();
                        
                    } else {
                        // 没有聊天记录
                        chatMessages.innerHTML = `
                            <div style="text-align: center; color: #999; padding: 40px 0;">
                                <i class="fas ${isAI ? 'fa-robot' : 'fa-comments'}" style="font-size: 40px; margin-bottom: 15px;"></i>
                                <h3>开始与 ${contactName} ${isAI ? '(AI)' : ''}聊天</h3>
                                <p>发送第一条消息开始对话</p>
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    console.error(`加载${isAI ? 'AI' : '好友'}聊天记录失败:`, error);
                    
                    chatMessages.innerHTML = `
                        <div style="text-align: center; color: #999; padding: 40px 0;">
                            <i class="fas fa-exclamation-triangle" style="font-size: 40px; margin-bottom: 15px; color: #f44336;"></i>
                            <h3>加载聊天记录失败</h3>
                            <p>无法加载与 ${contactName} 的聊天记录</p>
                            <button onclick="location.reload()" style="margin-top: 20px; padding: 10px 20px; background: #07c160; color: white; border: none; border-radius: 5px; cursor: pointer;">
                                刷新页面
                            </button>
                        </div>
                    `;
                });
            }
            
            // ========== 添加消息到聊天界面 ==========
            function addMessageToChat(message, timestamp, isFromOther, isOffline = false, isAI = false, senderId = null) {
                const messageDiv = document.createElement('div');
                messageDiv.className = isFromOther ? 'message-other' : 'message-self';
                
                const timeStr = timestamp || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                
                // 创建AI消息的指示器（仅当是AI发送的消息时显示）
                const aiIndicator = isAI && isFromOther ? '<span class="ai-message-indicator">AI</span>' : '';
                
                messageDiv.innerHTML = `
                    <div class="${isFromOther ? 'message-bubble-other' : 'message-bubble-self'}">
                        ${message}
                        <div class="message-time ${isFromOther ? 'message-time-other' : ''}">
                            ${timeStr} ${aiIndicator}
                        </div>
                        ${isOffline ? `<div class="message-status ${isFromOther ? 'message-status-other' : ''}">[离线]</div>` : ''}
                    </div>
                `;
                
                chatMessages.appendChild(messageDiv);
            }
            
            // ========== 显示AI正在输入的动画 ==========
            function showAIThinking() {
                // 如果已经在显示，则不重复添加
                if (document.querySelector('.typing-indicator')) {
                    return;
                }
                
                const typingDiv = document.createElement('div');
                typingDiv.className = 'message-other typing-indicator';
                typingDiv.innerHTML = `
                    <div class="message-bubble-other">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <div class="message-time message-time-other" style="margin-top: 8px;">
                            AI正在思考...
                        </div>
                    </div>
                `;
                
                chatMessages.appendChild(typingDiv);
                scrollToBottom();
            }
            
            // ========== 隐藏AI正在输入的动画 ==========
            function hideAIThinking() {
                const typingIndicator = document.querySelector('.typing-indicator');
                if (typingIndicator) {
                    typingIndicator.remove();
                }
            }
            
            // ========== 添加离线消息分隔线 ==========
            function addOfflineDivider() {
                const divider = document.createElement('div');
                divider.className = 'offline-divider';
                divider.textContent = '以上是离线消息';
                chatMessages.appendChild(divider);
            }
            
            // ========== 添加时间分隔线 ==========
            function addTimeDivider(dateStr) {
                const divider = document.createElement('div');
                divider.className = 'time-divider';
                divider.innerHTML = `<span>${formatDate(dateStr)}</span>`;
                chatMessages.appendChild(divider);
            }
            
            // ========== 格式化日期 ==========
            function formatDate(dateStr) {
                if (!dateStr) return '';
                
                const date = new Date(dateStr);
                const today = new Date();
                const yesterday = new Date(today);
                yesterday.setDate(yesterday.getDate() - 1);
                
                if (date.toDateString() === today.toDateString()) {
                    return '今天';
                } else if (date.toDateString() === yesterday.toDateString()) {
                    return '昨天';
                } else {
                    return dateStr;
                }
            }
            
            // ========== 滚动到底部 ==========
            function scrollToBottom() {
                setTimeout(() => {
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }, 100);
            }
            
            // ========== 添加好友功能 ==========
            window.addFriend = function(userId, username) {
                if (!confirm(`确定要添加 ${username} 为好友吗？`)) {
                    return;
                }
                
                fetch('/user/search/add', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'add_friend',
                        targetUserId: userId,
                        targetUsername: username
                    })
                })
                .then(response => {
                    if(response.status == 200){
                        return response.json();
                    }
                    else{
                        throw new Error('添加失败，未知错误！');
                    }
                })
                .then(data => {
                    if (data.status == true) {
                        alert("添加好友成功");
                        // 重新加载所有联系人
                        loadAllContacts();
                    } else {
                        alert(data.message || '添加好友失败');
                    }
                })
                .catch(error => {
                    console.error('添加好友失败:', error);
                    alert('添加好友失败');
                });
            };
            
            // ========== 添加AI机器人功能 ==========
            window.addAI = function(aiId, aiName) {
                if (!confirm(`确定要添加 AI机器人 ${aiName} 吗？`)) {
                    return;
                }
                
                fetch('/user/aisearch/add', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'add_ai',
                        targetAIId: aiId,
                        aiName: aiName
                    })
                })
                .then(response => {
                    if(response.status == 200){
                        return response.json();
                    }
                    else{
                        throw new Error('添加失败，未知错误！');
                    }
                })
                .then(data => {
                    if (data.status == true) {
                        alert("添加AI机器人成功");
                        // 重新加载所有联系人
                        loadAllContacts();
                    } else {
                        alert(data.message || '添加AI机器人失败');
                    }
                })
                .catch(error => {
                    console.error('添加AI机器人失败:', error);
                    alert('添加AI机器人失败');
                });
            };
            
            // ========== 清空搜索 ==========
            window.clearSearch = function() {
                messageInput.value = '';
                messageInput.focus();
                sendBtn.disabled = true;
                
                // 恢复搜索界面
                const isAi = searchMode === 'ai';
                emptyChat.innerHTML = `
                    <i class="fas ${isAi ? 'fa-robot' : 'fa-search'} chat-icon"></i>
                    <h2>${isAi ? 'AI机器人搜索' : '搜索陌生人'}</h2>
                    <p>${isAi ? '按AI机器人名称搜索并添加' : '按用户名搜索并添加好友'}</p>
                `;
                emptyChat.style.display = 'flex';
                chatMessages.style.display = 'none';
            };
            
            // ========== 切换回微信模式 ==========
            function switchBackToWeChat() {
                // 1. 恢复右上角图标
                const navIcon = document.querySelector('.fa-arrow-left');
                if (navIcon) {
                    navIcon.classList.remove('fa-arrow-left');
                    navIcon.classList.add('fa-plus');
                    navIcon.title = '添加';
                    
                    // 移除返回事件，重新绑定点击事件（通过下拉菜单控制）
                    const newNavIcon = navIcon.cloneNode(true);
                    navIcon.parentNode.replaceChild(newNavIcon, navIcon);
                    
                    // 重新绑定下拉菜单事件
                    const newAddButton = document.getElementById('add-button');
                    if (newAddButton) {
                        newAddButton.addEventListener('click', function(e) {
                            e.stopPropagation();
                            dropdownMenu.classList.toggle('show');
                        });
                    }
                }
                
                // 2. 恢复聊天头部
                const chatHeader = document.querySelector('.chat-header');
                chatHeader.textContent = '选择一个聊天开始对话';
                
                // 3. 恢复空白聊天区域
                emptyChat.innerHTML = `
                    <i class="fas fa-comments chat-icon"></i>
                    <h2>开始聊天</h2>
                    <p>从左侧选择或添加好友/AI机器人开始聊天</p>
                `;
                emptyChat.style.display = 'flex';
                chatMessages.style.display = 'none';
                
                // 4. 恢复输入区域
                messageInput.placeholder = '选择一个联系人开始聊天...';
                messageInput.disabled = true;
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 5. 恢复按钮
                sendBtn.textContent = '发送';
                sendBtn.disabled = true;
                
                // 重要：重置按钮的事件监听器
                const oldSendBtn = sendBtn;
                const newSendBtn = sendBtn.cloneNode(true);
                sendBtn.parentNode.replaceChild(newSendBtn, sendBtn);
                
                // 重新获取新的按钮引用
                sendBtn = document.getElementById('send-btn');
                
                // 重新绑定发送消息的事件
                sendBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('发送按钮被点击');
                    originalSendBtnClick();
                });
                
                // 6. 恢复微信图标
                const searchIcon = document.querySelector('.fa-search, .fa-robot');
                if (searchIcon && searchIcon.closest('.navbar')) {
                    searchIcon.classList.remove('fa-search', 'fa-robot');
                    searchIcon.classList.add('fa-comment-alt');
                }
                
                // 7. 恢复标题
                document.title = '微信';
                
                // 8. 重置搜索模式
                searchMode = '';
                
                console.log('已切换回微信模式');
            }
            
            // ========== 自动调整输入框高度 ==========
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
            
            // ========== 标签页切换 ==========
            const tabItems = document.querySelectorAll('.tab-item');
            tabItems.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabItems.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    // 模拟页面切换
                    const tabLabel = this.querySelector('.tab-label').textContent;
                    alert(`切换到 ${tabLabel} 页面`);
                });
            });
            
            // ========== 搜索框功能 ==========
            const searchInput = document.querySelector('.search-input');
            searchInput.addEventListener('focus', function() {
                alert('搜索功能（模拟）\n这里可以集成实际的好友搜索逻辑');
            });
            
            // ========== 消息发送功能（适配AI和用户）==========
            const originalSendBtnClick = function() {
                console.log('发送函数被调用，当前联系人:', currentContact);
                
                if (!sendBtn.disabled && currentContact) {
                    const message = messageInput.value.trim();
                    console.log('要发送的消息:', message);
                    
                    if (message) {
                        // 获取当前选中的联系人
                        const contact = currentContact;
                        const isAI = contact.type === 'ai';
                        
                        // 1. 先在本地显示消息（即时反馈）
                        const messageData = {
                            message: message,
                            timestamp: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                            source: 'user',  // 'user'表示当前用户发送的消息（显示在右侧）
                            senderId: currentUserId || 'self',
                            isFromOther: false,
                            isAI: isAI
                        };
                        
                        // 添加到聊天历史
                        addMessageToHistory(contact.id, messageData);
                        
                        // 更新UI
                        addMessageToChat(message, messageData.timestamp, false, false, isAI, currentUserId);
                        
                        // 清空输入框
                        messageInput.value = '';
                        messageInput.style.height = 'auto';
                        
                        // 滚动到底部
                        scrollToBottom();
                        
                        // 2. 根据联系人类型发送到不同的服务器端点
                        const endpoint = isAI ? '/user/airobot/send' : '/user/friend/send';
                        
                        // 如果是AI，显示正在输入动画
                        if (isAI) {
                            showAIThinking();
                            isWaitingForAIResponse = true;
                        }
                        
                        // 禁用发送按钮，防止重复发送
                        sendBtn.disabled = true;
                        
                        fetch(endpoint, {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json' 
                            },
                            body: JSON.stringify({
                                action: isAI ? 'send_ai_message' : 'send_message',
                                targetId: contact.id,
                                targetName: contact.name,
                                message: message,
                                timestamp: Date.now()
                            })
                        })
                        .then(response => {
                            console.log('收到服务器响应:', response.status);
                            if(response.status == 200){
                                return response.json();
                            }
                            else{
                                throw new Error('发送失败，状态码:' + response.status);
                            }
                        })
                        .then(data => {
                            console.log('发送消息响应:', data);
                            
                            // 恢复发送按钮
                            sendBtn.disabled = false;
                            
                            if (data && data.status == true) {
                                console.log('消息发送成功');
                                
                                // 处理AI回复
                                if (isAI) {
                                    // 隐藏正在输入动画
                                    hideAIThinking();
                                    isWaitingForAIResponse = false;
                                    
                                    // 确保AI回复不为空
                                    let aiResponse = '';
                                    if (data.answer) {
                                        aiResponse = data.answer;
                                    } else if (data.message) {
                                        aiResponse = data.message;
                                    } else if (data.aiResponse) {
                                        aiResponse = data.aiResponse;
                                    } else {
                                        aiResponse = '抱歉，我暂时无法回答这个问题。';
                                    }
                                    
                                    // 创建AI回复消息数据
                                    const aiMessageData = {
                                        message: aiResponse,
                                        timestamp: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                                        source: 'robot',  // 'robot'表示AI发送的消息（显示在左侧）
                                        senderId: contact.id,
                                        isFromOther: true,
                                        isAI: true
                                    };
                                    
                                    // 添加到聊天历史
                                    addMessageToHistory(contact.id, aiMessageData);
                                    
                                    // 更新UI
                                    addMessageToChat(aiResponse, aiMessageData.timestamp, true, false, true, contact.id);
                                    
                                    // 滚动到底部
                                    scrollToBottom();
                                }
                            } else {
                                console.warn('消息发送可能失败:', data?.message);
                                
                                // 如果是AI，也隐藏正在输入动画
                                if (isAI) {
                                    hideAIThinking();
                                    isWaitingForAIResponse = false;
                                    
                                    // 显示错误消息
                                    const errorMessageData = {
                                        message: '抱歉，AI暂时无法响应。请稍后再试。',
                                        timestamp: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                                        source: 'robot',
                                        senderId: contact.id,
                                        isFromOther: true,
                                        isAI: true,
                                        isError: true
                                    };
                                    
                                    addMessageToHistory(contact.id, errorMessageData);
                                    addMessageToChat(errorMessageData.message, errorMessageData.timestamp, true, false, true, contact.id);
                                    scrollToBottom();
                                }
                            }
                        })
                        .catch(error => {
                            console.error('发送消息失败:', error);
                            
                            // 恢复发送按钮
                            sendBtn.disabled = false;
                            
                            // 如果是AI，隐藏正在输入动画
                            if (isAI) {
                                hideAIThinking();
                                isWaitingForAIResponse = false;
                                
                                // 显示错误消息
                                const errorMessageData = {
                                    message: '网络错误，请检查连接后重试。',
                                    timestamp: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                                    source: 'robot',
                                    senderId: contact.id,
                                    isFromOther: true,
                                    isAI: true,
                                    isError: true
                                };
                                
                                addMessageToHistory(contact.id, errorMessageData);
                                addMessageToChat(errorMessageData.message, errorMessageData.timestamp, true, false, true, contact.id);
                                scrollToBottom();
                            }
                        });
                        
                    } else {
                        alert('请输入消息内容');
                    }
                } else {
                    alert('请先选择一个联系人开始聊天');
                    console.log('发送失败原因: sendBtn.disabled=', sendBtn.disabled, 'currentContact=', currentContact);
                }
            };

            // ========== 绑定发送按钮点击事件 ==========
            sendBtn.addEventListener('click', function() {
                console.log('发送按钮被点击');
                originalSendBtnClick();
            });

            // ========== 按Enter键发送消息 ==========
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    console.log('Enter键被按下');
                    originalSendBtnClick();
                }
            });

            // ========== 辅助函数：更新推荐用户 ==========
            function updateSuggestedUsers(users) {
                // 这里可以显示推荐用户
                console.log('推荐用户:', users);
            }
            
            // ========== 辅助函数：更新推荐AI ==========
            function updateSuggestedAIs(ais) {
                // 这里可以显示推荐AI机器人
                console.log('推荐AI机器人:', ais);
            }

            console.log('微信界面已加载');
            console.log('修改：只在点击联系人时加载聊天记录，不再自动初始化所有联系人的聊天历史');
        });
    </script>
</body>

