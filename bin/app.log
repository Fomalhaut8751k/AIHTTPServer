    <script>
        // 点击右上角加号添加
        document.getElementById('search-plus').addEventListener('click', function() {
            console.log('✅ 按钮点击事件触发');
            
            // 添加防重复点击
            if (this.dataset.loading === 'true') {
                console.log('⚠️ 请求已在进行中，忽略点击');
                return;
            }
            this.dataset.loading = 'true';
            
            fetch('/user/search', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    action: 'click',
                    timestamp: Date.now(),
                    buttonId: 'search-plus'
                })
            })
            .then(response => {
                console.log('✅ Fetch完成，收到Response对象');
                console.log('状态码:', response.status);
                console.log('状态文本:', response.statusText);
                console.log('URL:', response.url);
                console.log('是否成功:', response.ok);
                
                // 检查网络状态（非常重要！）
                if (!response.ok) {
                    console.error('❌ HTTP错误状态:', response.status);
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const contentType = response.headers.get('content-type');
                console.log('内容类型:', contentType);
                
                if (response.status === 200) {
                    if (contentType && contentType.includes('application/json')) {
                        console.log('📦 返回的是JSON，准备解析');
                        return response.json();
                    } else if (contentType && contentType.includes('text/html')) {
                        console.log('🌐 返回的是HTML，准备读取文本');
                        return response.text();
                    } else {
                        console.error('❌ 未知的内容类型:', contentType);
                        throw new Error('返回格式错误: ' + contentType);
                    }
                } else {
                    // 处理其他状态码
                    console.warn('⚠️ 状态码不是200:', response.status);
                    return response.text().then(text => {
                        console.log('响应内容:', text);
                        throw new Error(`状态码 ${response.status}: ${text}`);
                    });
                }
            })
            .then(data => {
                console.log('✅ .then() 链执行到这里了');
                console.log('数据类型:', typeof data);
                
                if (typeof data === 'string') {
                    console.log('📄 收到HTML字符串，长度:', data.length);
                    console.log('HTML预览（前200字符）:', data.substring(0, 200));
                    
                    const container = document.getElementById('display-area');
                    
                    if (!container) {
                        console.error('❌ 找不到容器元素 #display-area');
                        throw new Error('找不到显示区域');
                    }
                    
                    console.log('🎯 找到容器:', container);
                    console.log('容器当前内容长度:', container.innerHTML.length);
                    
                    // 清空并显示新内容
                    container.innerHTML = data;
                    console.log('✅ HTML已插入到容器中');
                    
                    // 检查是否真的显示出来了
                    setTimeout(() => {
                        console.log('容器新内容长度:', container.innerHTML.length);
                        console.log('容器第一个子元素:', container.children[0]?.tagName);
                    }, 100);
                    
                } else if (typeof data === 'object') {
                    console.log('📊 收到JSON对象:', data);
                    // 处理JSON数据...
                }
            })
            .catch(error => {
                console.error('❌ 捕获到错误:');
                console.error('错误名称:', error.name);
                console.error('错误消息:', error.message);
                console.error('错误堆栈:', error.stack);
                
                showAlert('操作失败: ' + error.message);
            })
            .finally(() => {
                // 重置加载状态
                document.getElementById('search-plus').dataset.loading = 'false';
                console.log('🏁 请求处理完成');
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            const messageInput = document.getElementById('message-input');
            const sendBtn = document.getElementById('send-btn');
            
            // 自动调整输入框高度
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
            
            // 模拟添加好友功能
            const addFriendBtn = document.querySelector('.fa-plus');
            
            // 标签页切换
            const tabItems = document.querySelectorAll('.tab-item');
            tabItems.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabItems.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    // 模拟页面切换
                    const tabLabel = this.querySelector('.tab-label').textContent;
                    alert(`切换到 ${tabLabel} 页面`);
                });
            });
            
            // 搜索框功能
            const searchInput = document.querySelector('.search-input');
            searchInput.addEventListener('focus', function() {
                alert('搜索功能（模拟）\n这里可以集成实际的好友搜索逻辑');
            });
            
            // 模拟消息发送（仅当有联系人时启用）
            sendBtn.addEventListener('click', function() {
                if (!sendBtn.disabled) {
                    const message = messageInput.value.trim();
                    if (message) {
                        alert(`发送消息：${message}\n（此处需要选中联系人才可发送）`);
                        messageInput.value = '';
                        messageInput.style.height = 'auto';
                    }
                }
            });
            
            // 按Enter键发送消息
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (!sendBtn.disabled) {
                        sendBtn.click();
                    }
                }
            });
            
            console.log('微信界面已加载');
            console.log('当前界面：简洁空白版，无联系人，无聊天记录');
        });
    </script>
</body>

