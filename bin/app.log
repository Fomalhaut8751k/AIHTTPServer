        /* AI机器人头像样式 - 改为紫色 */
        .avatar.ai-avatar {
            background-color: #9c27b0; /* 紫色 */
        }
        
        /* 消息样式 */
        .message-self {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 15px;
            padding: 0 20px;
        }
        
        .message-other {
            display: flex;
            justify-content: flex-start;
