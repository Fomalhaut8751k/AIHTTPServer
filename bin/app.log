<body>
    <!-- 顶部导航栏 -->
    <div class="navbar">
        <div style="display: flex; align-items: center;">
            <i class="fas fa-comment-alt" style="margin-right: 10px;"></i>
            <div class="app-name">WeChat</div>
        </div>
        <div>
            <i class="fas fa-plus nav-icon"></i>
        </div>
    </div>

    <!-- 主容器 -->
    <div class="main-container">
        <!-- 左侧边栏 -->
        <div class="sidebar">
            <div class="search-box">
                <input type="text" class="search-input" placeholder="搜索">
            </div>
            
            <div class="contact-list">
                <div class="empty-contacts">
                    <i class="fas fa-user-friends empty-icon"></i>
                    <h3>暂无联系人</h3>
                    <p>点击右上角"+"添加好友</p>
                </div>
            </div>
        </div>

        <!-- 搜索用户区域 -->
        <div class="chat-area">
            <!-- 搜索头部 -->
            <div class="chat-header">
                用户搜索
            </div>
            
            <!-- 搜索用户界面 -->
            <div class="search-user">
                <i class="fas fa-search search-icon"></i>
                <h2>搜索陌生人</h2>
                <p>按用户名搜索并添加好友</p>
                
                <!-- 搜索结果区域 -->
                <div class="search-result" id="search-result">
                    <!-- 搜索结果将通过JavaScript动态加载 -->
                </div>
            </div>
            
            <!-- 输入区域 -->
            <div class="input-area">
                <textarea class="message-input" id="search-input" placeholder="按用户名进行搜索..." rows="1"></textarea>
                <button class="search-btn" id="search-btn">查找</button>
            </div>
        </div>
    </div>
    
    <!-- 底部标签栏 -->
    <div class="tab-bar">
        <div class="tab-item active">
            <i class="fas fa-comment-alt tab-icon"></i>
            <div class="tab-label">微信</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-address-book tab-icon"></i>
            <div class="tab-label">通讯录</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-compass tab-icon"></i>
            <div class="tab-label">发现</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-user tab-icon"></i>
            <div class="tab-label">我</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('search-input');
            const searchBtn = document.getElementById('search-btn');
            const searchResult = document.getElementById('search-result');
            
            // 自动调整输入框高度
            searchInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
            
            // 模拟添加好友功能（右上角+按钮）
            const addFriendBtn = document.querySelector('.fa-plus');
            addFriendBtn.addEventListener('click', function() {
                alert('添加好友功能已移至搜索页面\n请使用右侧的搜索功能查找用户');
                // 聚焦到搜索框
                searchInput.focus();
            });
            
            // 标签页切换
            const tabItems = document.querySelectorAll('.tab-item');
            tabItems.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabItems.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    // 模拟页面切换
                    const tabLabel = this.querySelector('.tab-label').textContent;
                    alert(`切换到 ${tabLabel} 页面`);
                });
            });
            
            // 模拟搜索功能
            searchBtn.addEventListener('click', function() {
                const searchText = searchInput.value.trim();
                if (!searchText) {
                    alert('请输入要搜索的用户名');
                    return;
                }
                
                // 模拟搜索
                simulateSearch(searchText);
            });
            
            // 按Enter键搜索
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    searchBtn.click();
                }
            });
            
            // 模拟搜索用户
            function simulateSearch(username) {
                // 清空之前的搜索结果
                searchResult.innerHTML = '';
                
                // 模拟搜索结果
                const mockUsers = [
                    { id: 1, name: '张三', username: 'zhangsan', isFriend: false },
                    { id: 2, name: '李四', username: 'lisi', isFriend: false },
                    { id: 3, name: '王五', username: 'wangwu', isFriend: true }
                ];
                
                // 筛选匹配的用户
                const matchedUsers = mockUsers.filter(user => 
                    user.name.includes(username) || 
                    user.username.includes(username)
                );
                
                if (matchedUsers.length === 0) {
                    searchResult.innerHTML = `
                        <div class="empty-contacts">
                            <i class="fas fa-search empty-icon"></i>
                            <h3>未找到用户</h3>
                            <p>未找到匹配"${username}"的用户</p>
                        </div>
                    `;
                    return;
                }
                
                // 显示搜索结果
                matchedUsers.forEach(user => {
                    const userItem = document.createElement('div');
                    userItem.className = 'user-item';
                    
                    // 获取用户首字母作为头像
                    const firstLetter = user.name.charAt(0);
                    
                    userItem.innerHTML = `
                        <div class="user-avatar">${firstLetter}</div>
                        <div class="user-info">
                            <div class="user-name">${user.name}</div>
                            <div class="user-id">用户名: ${user.username}</div>
                        </div>
                        <button class="add-btn ${user.isFriend ? 'added' : ''}" 
                                data-user-id="${user.id}">
                            ${user.isFriend ? '已添加' : '添加好友'}
                        </button>
                    `;
                    
                    searchResult.appendChild(userItem);
                });
                
                // 添加点击事件
                const addButtons = document.querySelectorAll('.add-btn:not(.added)');
                addButtons.forEach(btn => {
                    btn.addEventListener('click', function() {
                        const userId = this.getAttribute('data-user-id');
                        addFriend(userId, this);
                    });
                });
            }
            
            // 模拟添加好友
            function addFriend(userId, button) {
                // 这里应该发送请求到服务器
                console.log(`添加好友: ${userId}`);
                
                // 模拟添加成功
                button.textContent = '已发送';
                button.classList.add('added');
                button.disabled = true;
                
                setTimeout(() => {
                    button.textContent = '已添加';
                    alert('好友请求已发送');
                }, 500);
            }
            
            // 左侧搜索框功能
            const leftSearchInput = document.querySelector('.search-input');
            leftSearchInput.addEventListener('focus', function() {
                alert('搜索功能已移至右侧\n请在右侧搜索陌生人并添加好友');
                // 聚焦到右侧搜索框
                searchInput.focus();
            });
            
            console.log('用户搜索界面已加载');
        });
    </script>
</body>

