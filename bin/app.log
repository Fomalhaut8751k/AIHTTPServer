            margin: 10px 0;
            font-size: 1.5em;
            color: #fff;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .menu-option:hover {
            color: #00e1ff;
            text-shadow: 0 0 5px #00e1ff;
        }

        .menu-border {
            margin: 10px auto;
            width: 80%;
            height: 2px;
            background: #00c3ff;
            box-shadow: 0 0 5px #00c3ff;
        }

