        }
        
        /* 头像容器样式 */
        .avatar-container {
            position: relative;
            width: 45px;
            height: 45px;
            margin-right: 12px;
        }
        
        .avatar {
            width: 45px;
            height: 45px;
            background-color: #07c160;
            border-radius: 50%;
            display: flex;
            align-items: center;
