        }

        .app-name {
            font-size: 18px;
            font-weight: bold;
        }

        .nav-icon {
            width: 20px;
            height: 20px;
            margin: 0 10px;
            cursor: pointer;
            opacity: 0.8;
        }

        .nav-icon:hover {
