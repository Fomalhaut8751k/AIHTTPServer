        .switch {
            margin-top: 15px;
            font-size: 14px;
            text-align: center;
            color: #555;
        }

        .switch a {
            color: #007BFF;
            text-decoration: none;
            cursor: pointer;
        }

        .switch a:hover {
            text-decoration: underline;
        }

        #register-container {
            display: none;
        }

        /* 登录/注册成功蓝色提示框 */
        #success-alert {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #007BFF;
            color: white;
            padding: 10px 20px;
