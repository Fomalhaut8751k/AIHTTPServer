            display: flex;
            align-items: flex-start;
            position: relative;
        }

        .control-panel {
            position: absolute;
            left: 100%;
            margin-left: 30px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            top: 20px;
        }

        .control-btn {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .control-btn:hover {
            background-color: #45a049;
        }

        .control-btn.return {
            background-color: #f44336;
        }

        .control-btn.return:hover {
            background-color: #da190b;
        }

