            color: white;
            font-size: 18px;
        }
        
        /* 消息样式 */
        .message-self {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 15px;
            padding: 0 20px;
        }
        
        .message-other {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 15px;
            padding: 0 20px;
        }
        
        .message-bubble-self {
            max-width: 70%;
            background-color: #07c160;
            color: white;
            padding: 10px 15px;
            border-radius: 18px 18px 4px 18px;
            font-size: 14px;
            word-break: break-word;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }
        
        .message-bubble-other {
            max-width: 70%;
            background-color: white;
            color: #333;
            padding: 10px 15px;
            border-radius: 18px 18px 18px 4px;
            font-size: 14px;
