            margin-top: 15px;
            font-size: 14px;
            text-align: center;
            color: #555;
        }

        .switch a {
            color: #007BFF;
            text-decoration: none;
            cursor: pointer;
        }

        .switch a:hover {
            text-decoration: underline;
        }

