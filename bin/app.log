        .progress-bar {
            width: 300px;
            height: 20px;
            background: #444;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 10px #000;
        }

        .progress-bar-inner {
            height: 100%;
            background: linear-gradient(to right, #00c3ff, #00e1ff);
            width: 0;
            transition: width 1.5s ease;
        }

        /* 加载提示文字 */
        #loading-text {
            margin-top: 15px;
            font-size: 1.2em;
            color: #ccc;
        }

        /* 菜单页面样式 */
        #menu-container {
            display: none;
            text-align: center;
            padding: 50px 20px;
        }

