        .message-status {
            font-size: 10px;
            margin-top: 3px;
            color: rgba(255, 255, 255, 0.7);
            text-align: right;
        }
        
        .message-status-other {
            color: rgba(0, 0, 0, 0.5);
        }
        
        /* 聊天区域占位符 - 当没有消息时显示 */
        .chat-placeholder {
            flex: 1;
