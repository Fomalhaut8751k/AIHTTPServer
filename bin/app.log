        }

        /* 聊天区域 */
        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: #f0f0f0;
        }

        /* 聊天头部 */
        .chat-header {
            height: 50px;
            background-color: white;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            padding: 0 15px;
            font-weight: bold;
            color: #666;
        }

        /* 空白聊天界面 */
        .empty-chat {
