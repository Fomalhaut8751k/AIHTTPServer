            <!-- 聊天消息容器 -->
            <div class="chat-messages-container">
                <!-- 空白聊天界面 -->
                <div class="empty-chat" id="empty-chat">
                    <i class="fas fa-comments chat-icon"></i>
                    <h2>开始聊天</h2>
                    <p>从左侧选择或添加好友开始聊天</p>
                </div>
                
                <!-- 聊天消息区域（动态生成） -->
                <div class="chat-messages" id="chat-messages" style="display: none;"></div>
            </div>
            
            <!-- 输入区域 -->
            <div class="input-area">
                <textarea class="message-input" id="message-input" placeholder="选择一个联系人开始聊天..." rows="1" disabled></textarea>
                <button class="send-btn" id="send-btn" disabled>发送</button>
            </div>
        </div>
    </div>
    
    <!-- 底部标签栏 -->
    <div class="tab-bar">
        <div class="tab-item active">
            <i class="fas fa-comment-alt tab-icon"></i>
            <div class="tab-label">微信</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-address-book tab-icon"></i>
            <div class="tab-label">通讯录</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-compass tab-icon"></i>
            <div class="tab-label">发现</div>
        </div>
        <div class="tab-item">
            <i class="fas fa-user tab-icon"></i>
            <div class="tab-label">我</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let messageInput = document.getElementById('message-input');
            let sendBtn = document.getElementById('send-btn');
            const emptyChat = document.getElementById('empty-chat');
            const chatMessages = document.getElementById('chat-messages');
            
            // ========== 全局数据存储 ==========
            let offlineMessages = {};      // 离线消息（未读）
            let chatHistory = {};          // 聊天历史记录（持久化）
            let currentContact = null;     // 当前选中的联系人
            let currentUserId = null;      // 当前用户ID（需要从服务器获取）
            
            // ========== 页面加载时自动获取联系人列表 ==========
            fetch('/user/friendlist', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json' 
                },
                body: JSON.stringify({
                    action: 'get_contact_list'
                })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                console.log('收到联系人数据:', data);
                
                // 处理联系人数据
                if (data && data.contacts && data.contacts.length > 0) {
                    updateContactList(data.contacts);
                    
                    // 初始化聊天历史记录
                    data.contacts.forEach(contact => {
                        const contactId = contact.id;
                        if (!chatHistory[contactId]) {
                            chatHistory[contactId] = [];
                        }
                    });
                    
                    // ========== 获取当前用户ID ==========
                    // 这里假设从服务器返回的数据中包含当前用户ID
                    if (data.currentUserId) {
                        currentUserId = data.currentUserId;
                        console.log('当前用户ID:', currentUserId);
                    }
                    
                    // ========== 获取离线消息 ==========
                    fetchOfflineMessages();
                    
                } else if (data && data.status === false) {
                    console.log('暂无联系人:', data.message);
                } else {
                    console.log('没有联系人数据');
                }
            })
            .catch(error => {
                console.error('获取联系人失败:', error);
            });
            
            // ========== 获取离线消息函数 ==========
            function fetchOfflineMessages() {
                fetch('/user/offlinemessage', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'get_offline_message'
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('收到离线消息数据:', data);
                    
                    if (data && data.status === true && data.message) {
                        processOfflineMessages(data.message);
                    }
                })
                .catch(error => {
                    console.error('获取离线消息失败:', error);
                });
            }
            
            // ========== 处理离线消息（适配新格式） ==========
            function processOfflineMessages(messageData) {
                offlineMessages = {};
                
                // 新的数据结构：{"message": {"2": [...], "3": [...]}, "status": true}
                if (messageData && messageData.message) {
                    // 遍历所有用户的消息
                    for (const [userId, messages] of Object.entries(messageData.message)) {
                        if (!offlineMessages[userId]) {
                            offlineMessages[userId] = [];
                        }
                        
                        // 将离线消息添加到离线消息列表
                        messages.forEach(msg => {
                            // 根据source判断消息方向
                            // source: true 表示对方是发送方（显示在左侧）
                            // source: false 表示当前用户是发送方（显示在右侧）
                            offlineMessages[userId].push({
                                message: msg.message,
                                timestamp: msg.timestamp,
                                isOffline: true,
                                source: msg.source, // true: 对方发送, false: 自己发送
                                senderId: msg.source ? userId : currentUserId
                            });
                        });
                    }
                }
                
                // 在联系人列表上显示红点
                showUnreadBadges();
            }
            
            // ========== 显示未读红点 ==========
            function showUnreadBadges() {
                const contactItems = document.querySelectorAll('.contact-item');
                
                contactItems.forEach(item => {
                    const onclickAttr = item.getAttribute('onclick');
                    if (onclickAttr) {
                        const match = onclickAttr.match(/selectContact\('(\d+)'/);
                        if (match) {
                            const contactId = match[1];
                            
                            if (offlineMessages[contactId] && offlineMessages[contactId].length > 0) {
                                // 移除可能已存在的红点
                                const existingBadge = item.querySelector('.unread-badge');
                                if (existingBadge) {
                                    existingBadge.remove();
                                }
                                
                                // 获取头像容器
                                const avatarContainer = item.querySelector('.avatar-container');
                                if (avatarContainer) {
                                    // 添加红点到头像容器
                                    const badge = document.createElement('div');
                                    badge.className = 'unread-badge';
                                    const unreadCount = offlineMessages[contactId].length;
                                    badge.innerHTML = unreadCount > 99 ? '99+' : unreadCount;
                                    
                                    // 添加悬停效果
                                    badge.style.cursor = 'pointer';
                                    badge.title = `${unreadCount}条未读消息`;
                                    
                                    avatarContainer.appendChild(badge);
                                }
                            }
                        }
                    }
                });
            }
            
            // ========== 将离线消息合并到聊天历史 ==========
            function mergeOfflineToHistory(userId) {
                if (offlineMessages[userId] && offlineMessages[userId].length > 0) {
                    // 将离线消息添加到聊天历史
                    offlineMessages[userId].forEach(msg => {
                        addMessageToHistory(userId, msg);
                    });
                    
                    // 清除离线消息
                    delete offlineMessages[userId];
                    
                    // 更新UI上的红点
                    const contactItems = document.querySelectorAll('.contact-item');
                    contactItems.forEach(item => {
                        const onclickAttr = item.getAttribute('onclick');
                        if (onclickAttr) {
                            const match = onclickAttr.match(/selectContact\('(\d+)'/);
                            if (match && match[1] === userId) {
                                const badge = item.querySelector('.unread-badge');
                                if (badge) {
                                    badge.remove();
                                }
                            }
                        }
                    });
                    
                    return true; // 有离线消息被合并
                }
                return false; // 没有离线消息
            }
            
            // ========== 添加消息到聊天历史（适配新格式） ==========
            function addMessageToHistory(userId, messageData) {
                if (!chatHistory[userId]) {
                    chatHistory[userId] = [];
                }
                
                // 添加到历史记录
                chatHistory[userId].push(messageData);
                
                // 按时间排序
                chatHistory[userId].sort((a, b) => {
                    return new Date(a.timestamp || 0) - new Date(b.timestamp || 0);
                });
            }
            
            // ========== 模拟添加好友功能 ==========
            const addFriendBtn = document.querySelector('.fa-plus');
            addFriendBtn.addEventListener('click', function() {
                // 切换到搜索模式
                switchToSearchMode();
                
                // 发送POST请求获取搜索数据
                fetch('/user/search', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'get_search_ui'  // 请求搜索UI数据
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    return response.json();
                })
                .then(data => {
                    console.log('收到搜索数据:', data);
                    
                    // 如果有数据，可以更新UI
                    if (data && data.suggestedUsers) {
                        // 可以在这里显示推荐用户
                        updateSuggestedUsers(data.suggestedUsers);
                    }
                })
                .catch(error => {
                    console.error('请求失败:', error);
                    alert('搜索功能暂时不可用');
                });
            });
            
            // ========== 切换到搜索模式 ==========
            function switchToSearchMode() {
                // 1. 修改右上角图标：+ 换成 ←
                const navIcon = document.querySelector('.fa-plus');
                navIcon.classList.remove('fa-plus');
                navIcon.classList.add('fa-arrow-left');
                navIcon.title = '返回微信';
                
                // 移除原来的点击事件，添加返回功能
                const newNavIcon = navIcon.cloneNode(true);
                navIcon.parentNode.replaceChild(newNavIcon, navIcon);
                
                newNavIcon.addEventListener('click', function() {
                    switchBackToWeChat();
                });
                
                // 2. 修改聊天头部
                const chatHeader = document.querySelector('.chat-header');
                chatHeader.textContent = '用户搜索';
                
                // 3. 修改空白聊天区域
                emptyChat.innerHTML = `
                    <i class="fas fa-search chat-icon"></i>
                    <h2>搜索陌生人</h2>
                    <p>按用户名搜索并添加好友</p>
                `;
                emptyChat.style.display = 'flex';
                chatMessages.style.display = 'none';
                
                // 4. 修改输入区域
                messageInput.placeholder = '按用户名进行搜索';
                messageInput.disabled = false;
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 5. 修改按钮
                sendBtn.textContent = '查找';
                sendBtn.disabled = true;
                
                // 重要：先移除原来的事件监听器，然后添加新的事件
                // 创建一个新的按钮元素来完全替换事件监听
                const oldSendBtn = sendBtn;
                const newSendBtn = sendBtn.cloneNode(true);
                sendBtn.parentNode.replaceChild(newSendBtn, sendBtn);
                
                // 重新获取新的按钮引用
                sendBtn = document.getElementById('send-btn');
                
                // 添加新的点击事件监听器
                sendBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('查找按钮被点击');
                    performSearch();
                });
                
                // 6. 修改左侧边栏的微信图标
                const wechatIcon = document.querySelector('.fa-comment-alt');
                if (wechatIcon) {
                    wechatIcon.classList.remove('fa-comment-alt');
                    wechatIcon.classList.add('fa-search');
                }
                
                // 7. 添加输入监听，启用查找按钮
                messageInput.addEventListener('input', function() {
                    const searchText = this.value.trim();
                    sendBtn.disabled = searchText.length === 0;
                });
                
                // 8. 修改标题（可选）
                document.title = '微信 - 用户搜索';
                
                console.log('已切换到搜索模式');
            }
            
            // ========== 执行搜索 ==========
            function performSearch() {
                const searchText = messageInput.value.trim();
                
                if (!searchText) {
                    alert('请输入要搜索的用户名');
                    return;
                }
                
                console.log('正在搜索用户:', searchText);
                
                // 禁用按钮，显示加载状态
                const originalText = sendBtn.textContent;
                sendBtn.textContent = '搜索中...';
                sendBtn.disabled = true;
                
                // 发送搜索请求
                fetch('/user/search/exist', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'search_user',
                        username: searchText,
                        timestamp: Date.now()
                    })
                })
                .then(response => {
                    if(response.status == 200){
                        return response.json();
                    }
                    else{
                        throw new Error('搜索失败，未知错误！');
                    }
                })
                .then(data => {
                    console.log('搜索结果:', data);
                    
                    // 恢复按钮状态
                    sendBtn.textContent = originalText;
                    sendBtn.disabled = false;
                    
                    // 处理搜索结果
                    if(!data){
                        throw new Error('服务器返回空数据');
                    } 
                    if (data.status == true) {
                        displaySearchResults([{
                            userId: data.targetId,
                            username: searchText  // 使用搜索的用户名
                        }]);
                    } else {
                        alert('搜索失败，未找到对应的用户');
                    }
                })
                .catch(error => {
                    console.error('搜索失败:', error);
                    
                    // 恢复按钮状态
                    sendBtn.textContent = originalText;
                    sendBtn.disabled = false;
                    
                    alert('搜索失败，请稍后重试');
                });
                
                return false; // 防止默认行为和事件冒泡
            }
            
            // ========== 显示搜索结果 ==========
            function displaySearchResults(users) {
                emptyChat.innerHTML = '';
                
                if (users.length === 0) {
                    emptyChat.innerHTML = `
                        <i class="fas fa-user-slash chat-icon"></i>
                        <h2>未找到用户</h2>
                        <p>没有找到匹配的用户名</p>
                        <button onclick="clearSearch()" style="margin-top: 20px; padding: 10px 20px; background: #07c160; color: white; border: none; border-radius: 5px; cursor: pointer;">
                            重新搜索
                        </button>
                    `;
                    emptyChat.style.display = 'flex';
                    chatMessages.style.display = 'none';
                    return;
                }
                
                // 显示用户列表
                let usersHtml = `
                    <div style="text-align: left; width: 100%; max-width: 600px; margin: 0 auto;">
                        <h3 style="margin-bottom: 20px; color: #333;">找到 ${users.length} 个用户</h3>
                `;
                
                users.forEach((user, index) => {
                    usersHtml += `
                        <div style="display: flex; align-items: center; padding: 15px; background: white; border-radius: 8px; margin-bottom: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                            <div style="position: relative; width: 50px; height: 50px; margin-right: 15px;">
                                <div style="width: 50px; height: 50px; background: #07c160; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user" style="color: white; font-size: 20px;"></i>
                                </div>
                            </div>
                            <div style="flex: 1;">
                                <div style="font-weight: bold; font-size: 16px; color: #333;">${user.username || '未知用户'}</div>
                                <div style="font-size: 14px; color: #666; margin-top: 5px;">ID: ${user.userId || 'N/A'}</div>
                            </div>
                            <button onclick="addFriend('${user.userId}', '${user.username}')" 
                                    style="padding: 8px 15px; background: #07c160; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;">
                                添加好友
                            </button>
                        </div>
                    `;
                });
                
                usersHtml += `
                        <div style="margin-top: 20px; text-align: center;">
                            <button onclick="clearSearch()" style="padding: 10px 20px; background: #999; color: white; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                                重新搜索
                            </button>
                            <button onclick="switchBackToWeChat()" style="padding: 10px 20px; background: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer;">
                                返回微信
                            </button>
                        </div>
                    </div>
                `;
                
                emptyChat.innerHTML = usersHtml;
                emptyChat.style.display = 'block';
                chatMessages.style.display = 'none';
            }
            
            // ========== 更新联系人列表 ==========
            function updateContactList(contacts) {
                const contactListContainer = document.querySelector('.contact-list');
                if (!contactListContainer) return;
                
                // 创建联系人列表HTML
                let contactsHtml = '';
                
                contacts.forEach((contact, index) => {
                    // 获取联系人名字的第一个字符作为头像
                    const avatarText = contact.name && contact.name.length > 0 ? contact.name.charAt(0) : '?';
                    
                    contactsHtml += `
                        <div class="contact-item" style="display: flex; align-items: center; padding: 12px 15px; border-bottom: 1px solid #f0f0f0; cursor: pointer; transition: background-color 0.2s;" 
                             onclick="selectContact('${contact.id}', '${contact.name}')"
                             onmouseover="this.style.backgroundColor='#f9f9f9'"
                             onmouseout="this.style.backgroundColor='white'">
                            <div class="avatar-container">
                                <div class="avatar">
                                    ${avatarText}
                                </div>
                                <!-- 红点将动态添加到这里 -->
                            </div>
                            <div style="flex: 1;">
                                <div style="font-weight: bold; font-size: 15px; color: #333;">${contact.name}</div>
                                <div style="font-size: 12px; color: #999; margin-top: 3px;">ID: ${contact.id}</div>
                            </div>
                            <div style="color: #07c160; font-size: 12px; font-weight: bold; margin-right: 5px;">
                                好友
                            </div>
                        </div>
                    `;
                });
                
                // 更新联系人列表容器
                contactListContainer.innerHTML = `
                    <div style="overflow-y: auto; height: 100%;">
                        ${contactsHtml}
                    </div>
                `;
            }
            
            // ========== 选择联系人（增强版） ==========
            window.selectContact = function(userId, userName) {
                console.log(`选择了联系人: ${userName} (ID: ${userId})`);
                
                // 如果在搜索模式，先切换回微信模式
                if (document.title === '微信 - 用户搜索') {
                    switchBackToWeChat();
                }
                
                // 更新当前联系人
                currentContact = { id: userId, name: userName };
                
                // 更新聊天头部
                const chatHeader = document.querySelector('.chat-header');
                chatHeader.textContent = userName;
                
                // 清空输入框
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 启用输入区域
                messageInput.placeholder = `发送消息给 ${userName}...`;
                messageInput.disabled = false;
                sendBtn.disabled = false;
                
                // 将离线消息合并到聊天历史（如果有）
                const hasOfflineMessages = mergeOfflineToHistory(userId);
                
                // 显示聊天历史（持久化显示，每次打开都能看到）
                displayChatHistory(userId, userName, hasOfflineMessages);
            };
            
            // ========== 显示聊天历史（适配新格式） ==========
            function displayChatHistory(userId, userName, hasNewOfflineMessages = false) {
                // 隐藏空白聊天界面，显示聊天消息区域
                emptyChat.style.display = 'none';
                chatMessages.style.display = 'flex';
                
                // 清空聊天消息区域
                chatMessages.innerHTML = '';
                
                // 获取该联系人的聊天历史
                const history = chatHistory[userId];
                
                if (history && history.length > 0) {
                    // 有历史消息，显示所有消息
                    let hasOfflineMessagesShown = false;
                    let lastDate = null;
                    
                    history.forEach((msg, index) => {
                        // 检查是否是离线消息（并且是新接收的）
                        const isNewOffline = msg.isOffline && index >= history.length - (offlineMessages[userId]?.length || 0);
                        
                        // 如果是新离线消息，并且还没有添加分隔线，则添加
                        if (isNewOffline && hasNewOfflineMessages && !hasOfflineMessagesShown) {
                            addOfflineDivider();
                            hasOfflineMessagesShown = true;
                        }
                        
                        // 添加时间分隔线（每天一个）
                        const msgDate = msg.timestamp ? msg.timestamp.split(' ')[0] : null;
                        if (msgDate && msgDate !== lastDate) {
                            addTimeDivider(msgDate);
                            lastDate = msgDate;
                        }
                        
                        // 根据source判断消息方向
                        // source: true 表示对方是发送方（显示在左侧）
                        // source: false 表示当前用户是发送方（显示在右侧）
                        const isFromOther = msg.source === true;  // 对方发送的消息
                        
                        addMessageToChat(msg.message, msg.timestamp, isFromOther, msg.isOffline);
                    });
                    
                } else {
                    // 没有历史消息，显示初始提示
                    emptyChat.innerHTML = `
                        <div style="text-align: center; color: #999; padding: 40px 0;">
                            <i class="fas fa-comments" style="font-size: 40px; margin-bottom: 15px;"></i>
                            <h3>开始与 ${userName} 聊天</h3>
                            <p>发送第一条消息开始对话</p>
                        </div>
                    `;
                    emptyChat.style.display = 'flex';
                    chatMessages.style.display = 'none';
                }
                
                // 滚动到底部
                scrollToBottom();
            }
            
            // ========== 添加消息到聊天界面 ==========
            function addMessageToChat(message, timestamp, isFromOther, isOffline = false) {
                const messageDiv = document.createElement('div');
                messageDiv.className = isFromOther ? 'message-other' : 'message-self';
                
                const timeStr = timestamp || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                
                messageDiv.innerHTML = `
                    <div class="${isFromOther ? 'message-bubble-other' : 'message-bubble-self'}">
                        ${message}
                        <div class="message-time ${isFromOther ? 'message-time-other' : ''}">
                            ${timeStr}
                        </div>
                        ${isOffline ? `<div class="message-status ${isFromOther ? 'message-status-other' : ''}">[离线]</div>` : ''}
                    </div>
                `;
                
                chatMessages.appendChild(messageDiv);
            }
            
            // ========== 添加离线消息分隔线 ==========
            function addOfflineDivider() {
                const divider = document.createElement('div');
                divider.className = 'offline-divider';
                divider.textContent = '以上是离线消息';
                chatMessages.appendChild(divider);
            }
            
            // ========== 添加时间分隔线 ==========
            function addTimeDivider(dateStr) {
                const divider = document.createElement('div');
                divider.className = 'time-divider';
                divider.innerHTML = `<span>${formatDate(dateStr)}</span>`;
                chatMessages.appendChild(divider);
            }
            
            // ========== 格式化日期 ==========
            function formatDate(dateStr) {
                if (!dateStr) return '';
                
                const date = new Date(dateStr);
                const today = new Date();
                const yesterday = new Date(today);
                yesterday.setDate(yesterday.getDate() - 1);
                
                if (date.toDateString() === today.toDateString()) {
                    return '今天';
                } else if (date.toDateString() === yesterday.toDateString()) {
                    return '昨天';
                } else {
                    return dateStr;
                }
            }
            
            // ========== 滚动到底部 ==========
            function scrollToBottom() {
                setTimeout(() => {
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }, 100);
            }
            
            // ========== 添加好友功能 ==========
            window.addFriend = function(userId, username) {
                if (!confirm(`确定要添加 ${username} 为好友吗？`)) {
                    return;
                }
                
                fetch('/user/search/add', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'add_friend',
                        targetUserId: userId,
                        targetUsername: username
                    })
                })
                .then(response => {
                    if(response.status == 200){
                        return response.json();
                    }
                    else{
                        throw new Error('添加失败，未知错误！');
                    }
                })
                .then(data => {
                    if (data.status == true) {
                        alert("添加好友成功")
                        fetch('/user/friendlist', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json' 
                            },
                            body: JSON.stringify({
                                action: 'get_contact_list'
                            })
                        })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(`HTTP error! status: ${response.status}`);
                            }
                            return response.json();
                        })
                        .then(data => {
                            console.log('收到联系人数据:', data);
                            
                            // 处理联系人数据
                            if (data && data.contacts && data.contacts.length > 0) {
                                updateContactList(data.contacts);
                            } else if (data && data.status === false) {
                                console.log('暂无联系人:', data.message);
                            } else {
                                console.log('没有联系人数据');
                            }
                        })
                        .catch(error => {
                            console.error('获取联系人失败:', error);
                        });

                    } else {
                        alert(data.message || '添加好友失败');
                    }
                })
                .catch(error => {
                    console.error('添加好友失败:', error);
                    alert('添加好友失败');
                });
            };
            
            // ========== 清空搜索 ==========
            window.clearSearch = function() {
                messageInput.value = '';
                messageInput.focus();
                sendBtn.disabled = true;
                
                // 恢复搜索界面
                emptyChat.innerHTML = `
                    <i class="fas fa-search chat-icon"></i>
                    <h2>搜索陌生人</h2>
                    <p>按用户名搜索并添加好友</p>
                `;
                emptyChat.style.display = 'flex';
                chatMessages.style.display = 'none';
            };
            
            // ========== 切换回微信模式 ==========
            function switchBackToWeChat() {
                // 1. 恢复右上角图标
                const navIcon = document.querySelector('.fa-arrow-left');
                if (navIcon) {
                    navIcon.classList.remove('fa-arrow-left');
                    navIcon.classList.add('fa-plus');
                    navIcon.title = '添加好友';
                    
                    // 移除返回事件，重新绑定搜索事件
                    const newNavIcon = navIcon.cloneNode(true);
                    navIcon.parentNode.replaceChild(newNavIcon, navIcon);
                    
                    newNavIcon.addEventListener('click', function() {
                        switchToSearchMode();
                        fetch('/user/search/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action: 'get_search_ui'})
                        })
                        .then(response => response.json())
                        .then(data => {
                            console.log('收到搜索数据:', data);
                        })
                        .catch(error => {
                            console.error('请求失败:', error);
                        });
                    });
                }
                
                // 2. 恢复聊天头部
                const chatHeader = document.querySelector('.chat-header');
                chatHeader.textContent = '选择一个聊天开始对话';
                
                // 3. 恢复空白聊天区域
                emptyChat.innerHTML = `
                    <i class="fas fa-comments chat-icon"></i>
                    <h2>开始聊天</h2>
                    <p>从左侧选择或添加好友开始聊天</p>
                `;
                emptyChat.style.display = 'flex';
                chatMessages.style.display = 'none';
                
                // 4. 恢复输入区域
                messageInput.placeholder = '选择一个联系人开始聊天...';
                messageInput.disabled = true;
                messageInput.value = '';
                messageInput.style.height = 'auto';
                
                // 5. 恢复按钮
                sendBtn.textContent = '发送';
                sendBtn.disabled = true;
                
                // 重要：重置按钮的事件监听器
                const oldSendBtn = sendBtn;
                const newSendBtn = sendBtn.cloneNode(true);
                sendBtn.parentNode.replaceChild(newSendBtn, sendBtn);
                
                // 重新获取新的按钮引用
                sendBtn = document.getElementById('send-btn');
                
                // 重新绑定发送消息的事件
                sendBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('发送按钮被点击');
                    originalSendBtnClick();
                });
                
                // 6. 恢复微信图标
                const searchIcon = document.querySelector('.fa-search');
                if (searchIcon && searchIcon.closest('.navbar')) {
                    searchIcon.classList.remove('fa-search');
                    searchIcon.classList.add('fa-comment-alt');
                }
                
                // 7. 恢复标题
                document.title = '微信';
                
                console.log('已切换回微信模式');
            }
            
            // ========== 自动调整输入框高度 ==========
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
            
            // ========== 标签页切换 ==========
            const tabItems = document.querySelectorAll('.tab-item');
            tabItems.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabItems.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    // 模拟页面切换
                    const tabLabel = this.querySelector('.tab-label').textContent;
                    alert(`切换到 ${tabLabel} 页面`);
                });
            });
            
            // ========== 搜索框功能 ==========
            const searchInput = document.querySelector('.search-input');
            searchInput.addEventListener('focus', function() {
                alert('搜索功能（模拟）\n这里可以集成实际的好友搜索逻辑');
            });
            
            // ========== 消息发送功能（适配新格式） ==========
            const originalSendBtnClick = function() {
                console.log('发送函数被调用，当前联系人:', currentContact);
                
                if (!sendBtn.disabled && currentContact) {
                    const message = messageInput.value.trim();
                    console.log('要发送的消息:', message);
                    
                    if (message) {
                        // 获取当前选中的联系人
                        const contact = currentContact;
                        
                        // 1. 先在本地显示消息（即时反馈）
                        const messageData = {
                            message: message,
                            timestamp: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                            source: false,  // false表示当前用户发送的消息（显示在右侧）
                            senderId: currentUserId || 'self'
                        };
                        
                        // 添加到聊天历史
                        addMessageToHistory(contact.id, messageData);
                        
                        // 更新UI
                        addMessageToChat(message, messageData.timestamp, false, false);
                        
                        // 清空输入框
                        messageInput.value = '';
                        messageInput.style.height = 'auto';
                        
                        // 滚动到底部
                        scrollToBottom();
                        
                        // 2. 发送消息到服务器
                        fetch('/user/friend/send', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json' 
                            },
                            body: JSON.stringify({
                                action: 'send_message',
                                targetUserId: contact.id,
                                targetUsername: contact.name,
                                message: message,
                                timestamp: Date.now()
                            })
                        })
                        .then(response => {
                            console.log('收到服务器响应:', response.status);
                            if(response.status == 200){
                                return response.json();
                            }
                            else{
                                throw new Error('发送失败，状态码:' + response.status);
                            }
                        })
                        .then(data => {
                            console.log('发送消息响应:', data);
                            
                            if (data && data.status == true) {
                                console.log('消息发送成功');
                            } else {
                                console.warn('消息发送可能失败:', data?.message);
                            }
                        })
                        .catch(error => {
                            console.error('发送消息失败:', error);
                            // 这里可以添加重试逻辑或错误提示
                        });
                        
                    } else {
                        alert('请输入消息内容');
                    }
                } else {
                    alert('请先选择一个联系人开始聊天');
                    console.log('发送失败原因: sendBtn.disabled=', sendBtn.disabled, 'currentContact=', currentContact);
                }
            };

            // ========== 绑定发送按钮点击事件 ==========
            sendBtn.addEventListener('click', function() {
                console.log('发送按钮被点击');
                originalSendBtnClick();
            });

            // ========== 按Enter键发送消息 ==========
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    console.log('Enter键被按下');
                    originalSendBtnClick();
                }
            });

            // ========== 新增：加载聊天历史数据 ==========
            // 在页面加载时，可以调用这个函数来加载初始聊天历史
            function loadChatHistory() {
                fetch('/user/offlinemessage', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json' 
                    },
                    body: JSON.stringify({
                        action: 'get_chat_history'
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('收到聊天历史数据:', data);
                    
                    if (data && data.status === true && data.message) {
                        // 处理聊天历史数据
                        processChatHistory(data.message);
                    }
                })
                .catch(error => {
                    console.error('获取聊天历史失败:', error);
                });
            }
            
            // ========== 处理聊天历史数据 ==========
            function processChatHistory(messageData) {
                // 清空现有的聊天历史
                chatHistory = {};
                
                // 遍历所有用户的消息
                for (const [userId, messages] of Object.entries(messageData)) {
                    if (!chatHistory[userId]) {
                        chatHistory[userId] = [];
                    }
                    
                    // 将消息添加到聊天历史
                    messages.forEach(msg => {
                        chatHistory[userId].push({
                            message: msg.message,
                            timestamp: msg.timestamp,
                            source: msg.source,
                            senderId: msg.source ? userId : currentUserId
                        });
                    });
                    
                    // 按时间排序
                    chatHistory[userId].sort((a, b) => {
                        return new Date(a.timestamp || 0) - new Date(b.timestamp || 0);
                    });
                }
                
                console.log('聊天历史已加载:', chatHistory);
            }
            
            // 页面加载完成后加载聊天历史
            setTimeout(() => {
                loadChatHistory();
            }, 1000);

            console.log('微信界面已加载');
            console.log('当前界面：支持滚动的聊天框');
        });
    </script>
</body>

