        .tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #aaa;
            cursor: pointer;
            flex: 1;
            padding: 8px 0;
        }

        .tab-item.active {
            color: #07c160;
        }

        .tab-icon {
            font-size: 20px;
            margin-bottom: 3px;
        }

        .tab-label {
            font-size: 11px;
        }

        /* 滚动条样式 */
        ::-webkit-scrollbar {
