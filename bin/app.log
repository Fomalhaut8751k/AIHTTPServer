            align-items: center;
            justify-content: center;
            height: 100%;
            color: #999;
            padding: 20px;
            text-align: center;
        }

        .empty-icon {
            font-size: 40px;
            margin-bottom: 15px;
            color: #07c160;
        }

        /* 聊天区域 */
        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: #f0f0f0;
        }

        /* 聊天头部 */
        .chat-header {
            height: 50px;
            background-color: white;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            padding: 0 15px;
            font-weight: bold;
            color: #666;
            flex-shrink: 0; /* 防止头部被压缩 */
        }

        /* 空白聊天界面 */
        .empty-chat {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #999;
            padding: 20px;
            text-align: center;
        }

        .chat-icon {
            font-size: 50px;
            margin-bottom: 20px;
            color: #07c160;
        }

        /* 聊天消息容器 */
        .chat-messages-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* 确保内部滚动正确 */
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto; /* 允许垂直滚动 */
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            min-height: 0; /* 重要：允许内容溢出并滚动 */
        }

        /* 输入区域 */
        .input-area {
            background-color: white;
            padding: 10px 15px;
            border-top: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            flex-shrink: 0; /* 防止输入区域被压缩 */
        }

        .message-input {
            flex: 1;
            padding: 10px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
            resize: none;
            min-height: 40px;
            font-family: inherit;
        }

        .send-btn {
            background-color: #07c160;
            color: white;
