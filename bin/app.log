            margin-bottom: 3px;
        }

        .tab-label {
            font-size: 11px;
        }

        /* 滚动条样式 - 增强 */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(241, 241, 241, 0.5);
            border-radius: 3px;
