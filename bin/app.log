            flex: 1;
            padding: 8px 0;
        }

        .tab-item.active {
            color: #07c160;
        }

        .tab-icon {
            font-size: 20px;
            margin-bottom: 3px;
        }

        .tab-label {
            font-size: 11px;
        }

        /* 滚动条样式 */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 2px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
