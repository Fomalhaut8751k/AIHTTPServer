        }
        
        .message-time-other {
            color: #999;
        }
        
        .offline-divider {
            text-align: center;
            color: #999;
            padding: 10px 0;
            font-size: 12px;
            border-bottom: 1px solid #eee;
            margin-bottom: 15px;
            margin: 0 20px 15px 20px;
        }
        
        .message-status {
            font-size: 10px;
            margin-top: 3px;
            color: rgba(255, 255, 255, 0.7);
            text-align: right;
        }
        
        .message-status-other {
            color: rgba(0, 0, 0, 0.5);
        }
        
        /* 聊天区域占位符 - 当没有消息时显示 */
        .chat-placeholder {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            padding: 40px;
            text-align: center;
        }
        
        /* 时间分隔线 */
        .time-divider {
            text-align: center;
            margin: 20px 0;
            position: relative;
        }
        
        .time-divider span {
            background-color: rgba(255, 255, 255, 0.8);
            padding: 5px 15px;
            border-radius: 15px;
