            font-size: 2.5em;
            margin-bottom: 30px;
            color: #00c3ff;
            text-shadow: 0 0 5px #00c3ff, 0 0 10px #008bff;
        }

        .menu-option {
            margin: 10px 0;
            font-size: 1.5em;
            color: #fff;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .menu-option:hover {
            color: #00e1ff;
            text-shadow: 0 0 5px #00e1ff;
        }

