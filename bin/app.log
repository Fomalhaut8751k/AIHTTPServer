        }

        /* 聊天区域 */
        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: #f0f0f0;
        }

        /* 聊天头部 */
        .chat-header {
            height: 50px;
            background-color: white;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            padding: 0 15px;
            font-weight: bold;
            color: #666;
            flex-shrink: 0; /* 防止头部被压缩 */
        }

        /* 空白聊天界面 */
        .empty-chat {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #999;
            padding: 20px;
            text-align: center;
        }

        .chat-icon {
            font-size: 50px;
            margin-bottom: 20px;
            color: #07c160;
        }

        /* 聊天消息容器 */
        .chat-messages-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* 确保内部滚动正确 */
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto; /* 允许垂直滚动 */
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            min-height: 0; /* 重要：允许内容溢出并滚动 */
        }

        /* 输入区域 */
        .input-area {
