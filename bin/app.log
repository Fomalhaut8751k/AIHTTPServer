        /* 顶部导航栏 */
        .navbar {
            height: 50px;
            background-color: #2c2c2c;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 15px;
            color: white;
            position: relative;
            z-index: 1000;
