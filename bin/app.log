            flex-direction: column;
            overflow: hidden; /* 确保内部滚动正确 */
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto; /* 允许垂直滚动 */
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            min-height: 0; /* 重要：允许内容溢出并滚动 */
        }

        /* 输入区域 */
        .input-area {
            background-color: white;
            padding: 10px 15px;
            border-top: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            flex-shrink: 0; /* 防止输入区域被压缩 */
        }

        .message-input {
            flex: 1;
            padding: 10px 15px;
