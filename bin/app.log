                    },
                    body: JSON.stringify({
                        action: 'add_ai',
                        targetAIId: aiId,
                        aiName: aiName
                    })
                })
                .then(response => {
                    if(response.status == 200){
                        return response.json();
                    }
                    else{
                        throw new Error('添加失败，未知错误！');
                    }
                })
                .then(data => {
                    if (data.status == true) {
                        alert("添加AI机器人成功");
                        // 重新加载所有联系人
                        loadAllContacts();
                    } else {
